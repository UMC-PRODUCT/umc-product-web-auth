# 로컬 API base. 비우면 같은 origin 의 /api 로 요청하고, dev 서버가 프록시한다.
VITE_API_BASE_URL=

# TODO: SSO alpha api 호스트는 미확정이다.
# VITE_DEV_API_PROXY_TARGET=https://api-dev.university.neordinary.com

# 개발 배포 인증 앱에서만 필요. 쉼표로 origin 을 구분한다.
# TODO: 개발 배포 인증 앱 주소와 허용 return origin 은 미확정이다.
# VITE_ALLOWED_RETURN_ORIGINS=https://dev.admin.university.neordinary.com,https://dev.university.neordinary.com,http://localhost:5173

# 소셜 로그인 (미설정 시 버튼 클릭 시 안내 토스트)
# VITE_GOOGLE_CLIENT_ID=
# VITE_KAKAO_APP_KEY=
# 카카오 인가 코드 → 토큰 교환용. 없으면 VITE_KAKAO_APP_KEY 를 사용한다.
# VITE_KAKAO_REST_API_KEY=
# VITE_APPLE_CLIENT_ID=
# VITE_APPLE_REDIRECT_URI=

# 로그인 허브(/) 브랜딩. authorize 의 client_id 매핑 (서버 app.sso.clients 와 맞춤)
VITE_LOGIN_CLIENT_IDS_ACTIVITY=activity,activity-local
VITE_LOGIN_CLIENT_IDS_ADMIN=backoffice

# 운영진 권한 없음 Dialog CTA. 있으면 「UMC 홈으로」이동, 없으면 「확인」으로 닫기
# VITE_UMC_HOME_URL=https://university.neordinary.com


# UI 분기 강제 (로컬 전용). activity | admin | default
# 설정 시 client_id 보다 우선. / 만 열어도 해당 로고가 보임. 배포 전에는 비울 것.
# VITE_LOGIN_UI_TEST=activity

